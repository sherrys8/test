<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.secret.dyhide"
    android:versionCode="11"
    android:versionName="11.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>

    <application
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:label="dyhide"
        android:allowBackup="false">

        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:value="dyhide · 按名单隐藏抖音联系人 v11.0"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposedscope" android:value="com.ss.android.ugc.aweme"/>
        <meta-data android:name="xposedsharedprefs" android:value="true"/>

        <activity
            android:name="com.secret.dyhide.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <provider
            android:name="com.secret.dyhide.ConfigProvider"
            android:authorities="com.secret.dyhide.config"
            android:exported="true"/>
    </application>

    <queries>
        <package android:name="com.ss.android.ugc.aweme"/>
    </queries>
</manifest>
